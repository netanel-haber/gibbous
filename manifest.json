{
  "manifest_version": 3,
  "name": "Gibbous",
  "version": "0.7.3",
  "description": "GitHub, but with the UX you asked for. https://netanel-haber.github.io/gibbous/",
  "homepage_url": "https://netanel-haber.github.io/gibbous/",
  "minimum_chrome_version": "134",
  "permissions": ["storage"],
  "background": {"service_worker": "quote-worker.js"},
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["gibbous.css"],
      "js": ["gibbous.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://netanel-haber.github.io/gibbous/*"],
      "js": ["gibbous.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://viewscreen.githubusercontent.com/markdown/mermaid*"],
      "css": ["gibbous.css"],
      "js": ["gibbous.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
