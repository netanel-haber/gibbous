{
  "manifest_version": 3,
  "name": "Gibbous",
  "version": "0.4.5",
  "description": "GitHub, but with the UX you asked for. https://netanel-haber.github.io/gibbous/",
  "homepage_url": "https://netanel-haber.github.io/gibbous/",
  "permissions": ["storage"],
  "background": {"service_worker": "quote-worker.js"},
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://netanel-haber.github.io/gibbous/*"
      ],
      "js": ["theme-sync.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "css": [
        "gibbous.css",
        "pages/repository.css"
      ],
      "js": [
        "gibbous.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://viewscreen.githubusercontent.com/markdown/mermaid*"],
      "css": ["mermaid-frame.css"],
      "js": ["mermaid-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
